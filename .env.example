# Only needed for local remote-debugging against a running Dify instance
# (`dify plugin` dev loop). Not required to build the package or to install
# the published plugin. See https://docs.dify.ai/en/develop-plugin/getting-started/cli
INSTALL_METHOD=remote
REMOTE_INSTALL_HOST=debug-plugin.dify.dev
REMOTE_INSTALL_PORT=5003
REMOTE_INSTALL_KEY=your-debug-key-here
